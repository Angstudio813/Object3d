# ============================================================
#  Object3d - .gitignore GLOBAL (red de seguridad)
#  Cada proyecto tiene su propio .gitignore detallado:
#    - Objeto3D_Escritorio/.gitignore
#    - Objeto3D_VR/.gitignore
#  Estos patrones cubren cualquier proyecto nuevo que se
#  agregue a futuro sin necesidad de configurar nada.
# ============================================================

# --- Carpetas generadas por Unity ---
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
**/[Aa]ssets/_Recovery/
**/[Aa]ssets/_Recovery.meta

# --- Soluciones / proyectos generados por Unity o el IDE ---
**/*.csproj
**/*.unityproj
**/*.sln
**/*.slnx
**/*.suo
**/*.user
**/*.userprefs
**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db
**/.vs/
**/.vsconfig
**/.idea/

# --- Builds ---
**/*.apk
**/*.aab
**/*.unitypackage
**/*.app

# --- Sistema operativo ---
**/.DS_Store
**/._*
**/Thumbs.db
**/desktop.ini

# --- Editores ---
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/settings.json

# --- Temporales ---
**/*.tmp
**/*.bak
**/*.log
**/*.swp
**/*~
